# Cloudflare Pages security response headers for STATIC assets only.
# adapter-cloudflare requires this file in the project root (NOT static/) and
# appends its own immutable-asset caching rules. Server-rendered pages don't
# get these from here — src/hooks.server.ts sets the same set on them.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

